# 本地默认模式。不要把真实凭证写入此文件。
GONGWEI_TRANSPORT_MODE=local_rpc
GONGWEI_RUNTIME_MODE=local
GONGWEI_AUDIO_ENABLED=true

# platform_mq_inbox：管理员已提供公共连接参数；AIC 和证书由平台审核/CLI 返回后再填
# GONGWEI_MQ_BROKER_URL=amqps://wt.ioa.pub:5671
# Group ACL API：9007 直接接收 mTLS 客户端证书（2026-10-07 实测）。
# GONGWEI_MQ_AUTH_SERVICE_URL=https://wt.ioa.pub:9007
# GONGWEI_MQ_VHOST=/acps
# GONGWEI_MQ_TLS_MODE=mtls
# GONGWEI_MQ_INBOX_ENDPOINT=amqps://wt.ioa.pub:5671/acps?inbox=inbox_{AIC}
# MQ_BROKER_URL=amqps://wt.ioa.pub:5671
# MQ_AUTH_SERVICE_URL=https://wt.ioa.pub:9007
# MQ_VHOST=/acps
# MQ_TLS_MODE=mtls
# MQ_INBOX_ENDPOINT=amqps://wt.ioa.pub:5671/acps?inbox=inbox_{AIC}
# GONGWEI_MQ_LEADER_AIC=
# GONGWEI_MQ_RESOURCE_AIC=
# GONGWEI_MQ_WORKORDER_AIC=
# GONGWEI_MQ_CA_FILE=
# GONGWEI_MQ_CERT_FILE=
# GONGWEI_MQ_KEY_FILE=

# platform_https_rpc：仅在正式地址、AIC 和证书到位后填写
# GONGWEI_PUBLIC_LEADER_RPC_URL=
# GONGWEI_PUBLIC_RESOURCE_RPC_URL=
# GONGWEI_PUBLIC_WORKORDER_RPC_URL=
# GONGWEI_LEADER_AIC=
# GONGWEI_RESOURCE_AIC=
# GONGWEI_WORKORDER_AIC=
# GONGWEI_SERVER_CERT_FILE=
# GONGWEI_CLIENT_CERT_FILE=
# GONGWEI_PRIVATE_KEY_FILE=
# GONGWEI_TRUST_BUNDLE_FILE=
