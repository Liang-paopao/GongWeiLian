[Unit]
Description=Gongwei official mTLS Leader RPC with MQ Partners
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=gongwei-leader
DynamicUser=yes
SupplementaryGroups=gongwei-data
WorkingDirectory=/opt/gongwei/releases/20261007-platform
EnvironmentFile=/opt/gongwei/platform/leader.env
LoadCredential=identity:/opt/gongwei/secrets/generations/20261007/leader
Environment=GONGWEI_SECRETS_DIR=%d
Environment=GONGWEI_AICS_FILE=%d/identity_aics.json
Environment=MQ_CERT_FILE=%d/identity_certs_leader.crt
Environment=MQ_KEY_FILE=%d/identity_certs_private_leader.key
Environment=MQ_CA_FILE=%d/identity_certs_trust-bundle.pem
Environment=GONGWEI_LEADER_SERVER_CERT=%d/identity_certs_leader-server.crt
Environment=GONGWEI_LEADER_SERVER_KEY=%d/identity_certs_private_leader-server.key
Environment=GONGWEI_LEADER_CLIENT_CA=%d/identity_certs_trust-bundle.pem
Environment=GONGWEI_LEADER_RPC_STATE_DB=/var/lib/gongwei-leader/rpc.sqlite3
Environment=GONGWEI_LOG_DIR=/var/log/gongwei-leader
StateDirectory=gongwei-leader
LogsDirectory=gongwei-leader
ExecStart=/opt/gongwei/.venv/bin/python run_leader_rpc.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/gongwei/shared/data
UMask=0007
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
