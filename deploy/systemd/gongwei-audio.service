[Unit]
Description=Gongwei optional audio Partner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/gongwei/current
EnvironmentFile=/opt/gongwei/gongwei.env
ExecStart=/opt/gongwei/.venv/bin/python -m uvicorn audio_partner_v1:app --host 127.0.0.1 --port 18114
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
ReadWritePaths=/opt/gongwei
StandardOutput=append:/opt/gongwei/shared/logs/audio.service.log
StandardError=append:/opt/gongwei/shared/logs/audio.service.log

[Install]
WantedBy=multi-user.target
