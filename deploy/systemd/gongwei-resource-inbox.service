[Unit]
Description=Gongwei official resource MQ Inbox
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=gongwei-resource-mq
DynamicUser=yes
SupplementaryGroups=gongwei-data
WorkingDirectory=/opt/gongwei/releases/20261007-platform
EnvironmentFile=/opt/gongwei/platform/leader.env
LoadCredential=identity:/opt/gongwei/secrets/generations/20261007/resource
Environment=GONGWEI_SECRETS_DIR=%d
Environment=GONGWEI_AICS_FILE=%d/identity_aics.json
Environment=MQ_CERT_FILE=%d/identity_certs_resource_partner.crt
Environment=MQ_KEY_FILE=%d/identity_certs_private_resource_partner.key
Environment=MQ_CA_FILE=%d/identity_certs_trust-bundle.pem
Environment=GONGWEI_LOG_DIR=/var/log/gongwei-resource-inbox
LogsDirectory=gongwei-resource-inbox
ExecStart=/opt/gongwei/.venv/bin/python run_partner_inbox.py --role resource
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/gongwei/shared/data
UMask=0007
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
