[Unit]
Description=Gongwei approved protocol metadata forwarder
After=network-online.target gongwei-leader.service gongwei-resource-inbox.service gongwei-workorder-inbox.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gongwei/tools/amp-metadata
ExecStart=/opt/gongwei/.venv/bin/python -B /opt/gongwei/tools/amp-metadata/amp_metadata_forwarder.py --config /etc/gongwei/amp-metadata.json --public-protocol-metadata-plaintext
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1
StateDirectory=gongwei-amp-metadata
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
InaccessiblePaths=-/opt/gongwei/secrets -/opt/gongwei/backups -/opt/gongwei/platform -/opt/gongwei/shared/data -/var/lib/gongwei-leader -/run/credentials
TemporaryFileSystem=/var/log:ro
BindReadOnlyPaths=/var/log/gongwei-leader /var/log/gongwei-resource-inbox /var/log/gongwei-workorder-inbox

[Install]
WantedBy=multi-user.target
