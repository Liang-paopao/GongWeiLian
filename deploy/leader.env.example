# Public configuration only. systemd provides this service's private identity.
GONGWEI_TRANSPORT_MODE=platform_mq_inbox
GONGWEI_RUNTIME_MODE=local
GONGWEI_STAGE2_DB=/opt/gongwei/shared/data/stage2.db
GONGWEI_DISCOVERY_URL=https://wt.ioa.pub/discovery
# platform_catalog requires the approved Partner AICs for exact identity binding.
# Keep these values in sync with the current approved registrations.
GONGWEI_MQ_RESOURCE_AIC=1.2.156.3088.1.BUPT.JSQB3Y.E164E8.FWIZ4R.03IA
GONGWEI_MQ_WORKORDER_AIC=1.2.156.3088.1.BUPT.JSQB3Y.Q9QG7Q.14TNDP.0WSF
GONGWEI_LEADER_RPC_HOST=127.0.0.1
GONGWEI_LEADER_RPC_PORT=18443
GONGWEI_LEADER_PUBLIC_HOSTNAME=leader.yanyi.online
MQ_BROKER_URL=amqps://wt.ioa.pub:5671
# Official mTLS Group API; verified with these identities on 2026-10-07.
# The 443 /mq-auth/ proxy currently does not pass a client certificate.
MQ_AUTH_SERVICE_URL=https://wt.ioa.pub:9007
MQ_VHOST=/acps
PYTHONUNBUFFERED=1
NO_PROXY=127.0.0.1,localhost,::1
