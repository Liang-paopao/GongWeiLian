  "web_unit": "# /etc/systemd/system/gongwei-web.service\n[Unit]\nDescription=Gongwei web and Leader API\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=simple\nUser=ubuntu\nGroup=ubuntu\nWorkingDirectory=/opt/gongwei/current\nEnvironmentFile=/opt/gongwei/gongwei.env\nExecStart=/opt/gongwei/.venv/bin/python -m uvicorn web_app:app --host 127.0.0.1 --port 18110\nRestart=on-failure\nRestartSec=5\nNoNewPrivileges=true\nPrivateTmp=true\nUMask=0077\nReadWritePaths=/opt/gongwei\nStandardOutput=append:/opt/gongwei/shared/logs/web.service.log\nStandardError=append:/opt/gongwei/shared/logs/web.service.log\n\n[Install]\nWantedBy=multi-user.target\n",
  "leader_unit": "# /etc/systemd/system/gongwei-leader.service\n[Unit]\nDescription=Gongwei official mTLS Leader RPC with MQ Partners\nAfter=network-online.target\nWants=network-online.target\nStartLimitIntervalSec=120\nStartLimitBurst=3\n\n[Service]\nType=simple\nUser=gongwei-leader\nDynamicUser=yes\nSupplementaryGroups=gongwei-data\nWorkingDirectory=/opt/gongwei/releases/20261007-platform\nEnvironmentFile=/opt/gongwei/platform/leader.env\nLoadCredential=identity:/opt/gongwei/secrets/generations/20261007/leader\nEnvironment=GONGWEI_SECRETS_DIR=%d\nEnvironment=GONGWEI_AICS_FILE=%d/identity_aics.json\nEnvironment=MQ_CERT_FILE=%d/identity_certs_leader.crt\nEnvironment=MQ_KEY_FILE=%d/identity_certs_private_leader.key\nEnvironment=MQ_CA_FILE=%d/identity_certs_trust-bundle.pem\nEnvironment=GONGWEI_LEADER_SERVER_CERT=%d/identity_certs_leader-server.crt\nEnvironment=GONGWEI_LEADER_SERVER_KEY=%d/identity_certs_private_leader-server.key\nEnvironment=GONGWEI_LEADER_CLIENT_CA=%d/identity_certs_trust-bundle.pem\nEnvironment=GONGWEI_LEADER_RPC_STATE_DB=/var/lib/gongwei-leader/rpc.sqlite3\nEnvironment=GONGWEI_LOG_DIR=/var/log/gongwei-leader\nStateDirectory=gongwei-leader\nLogsDirectory=gongwei-leader\nExecStart=/opt/gongwei/.venv/bin/python run_leader_rpc.py\nRestart=on-failure\nRestartSec=10\nTimeoutStopSec=45\nNoNewPrivileges=true\nPrivateTmp=true\nProtectSystem=strict\nProtectHome=true\nProtectKernelTunables=true\nProtectKernelModules=true\nProtectControlGroups=true\nRestrictSUIDSGID=true\nReadWritePaths=/opt/gongwei/shared/data\nUMask=0007\nStandardOutput=journal\nStandardError=journal\n\n[Install]\nWantedBy=multi-user.target\n",
  "resource-inbox_unit": "# /etc/systemd/system/gongwei-resource-inbox.service\n[Unit]\nDescription=Gongwei official resource MQ Inbox\nAfter=network-online.target\nWants=network-online.target\nStartLimitIntervalSec=120\nStartLimitBurst=3\n\n[Service]\nType=simple\nUser=gongwei-resource-mq\nDynamicUser=yes\nSupplementaryGroups=gongwei-data\nWorkingDirectory=/opt/gongwei/releases/20261007-platform\nEnvironmentFile=/opt/gongwei/platform/leader.env\nLoadCredential=identity:/opt/gongwei/secrets/generations/20261007/resource\nEnvironment=GONGWEI_SECRETS_DIR=%d\nEnvironment=GONGWEI_AICS_FILE=%d/identity_aics.json\nEnvironment=MQ_CERT_FILE=%d/identity_certs_resource_partner.crt\nEnvironment=MQ_KEY_FILE=%d/identity_certs_private_resource_partner.key\nEnvironment=MQ_CA_FILE=%d/identity_certs_trust-bundle.pem\nEnvironment=GONGWEI_LOG_DIR=/var/log/gongwei-resource-inbox\nLogsDirectory=gongwei-resource-inbox\nExecStart=/opt/gongwei/.venv/bin/python run_partner_inbox.py --role resource\nRestart=on-failure\nRestartSec=10\nTimeoutStopSec=45\nNoNewPrivileges=true\nPrivateTmp=true\nProtectSystem=strict\nProtectHome=true\nProtectKernelTunables=true\nProtectKernelModules=true\nProtectControlGroups=true\nRestrictSUIDSGID=true\nReadWritePaths=/opt/gongwei/shared/data\nUMask=0007\nStandardOutput=journal\nStandardError=journal\n\n[Install]\nWantedBy=multi-user.target\n",
  "workorder-inbox_unit": "# /etc/systemd/system/gongwei-workorder-inbox.service\n[Unit]\nDescription=Gongwei official workorder MQ Inbox\nAfter=network-online.target\nWants=network-online.target\nStartLimitIntervalSec=120\nStartLimitBurst=3\n\n[Service]\nType=simple\nUser=gongwei-workorder-mq\nDynamicUser=yes\nSupplementaryGroups=gongwei-data\nWorkingDirectory=/opt/gongwei/releases/20261007-platform\nEnvironmentFile=/opt/gongwei/platform/leader.env\nLoadCredential=identity:/opt/gongwei/secrets/generations/20261007/workorder\nEnvironment=GONGWEI_SECRETS_DIR=%d\nEnvironment=GONGWEI_AICS_FILE=%d/identity_aics.json\nEnvironment=MQ_CERT_FILE=%d/identity_certs_workorder.crt\nEnvironment=MQ_KEY_FILE=%d/identity_certs_private_workorder.key\nEnvironment=MQ_CA_FILE=%d/identity_certs_trust-bundle.pem\nEnvironment=GONGWEI_LOG_DIR=/var/log/gongwei-workorder-inbox\nLogsDirectory=gongwei-workorder-inbox\nExecStart=/opt/gongwei/.venv/bin/python run_partner_inbox.py --role workorder\nRestart=on-failure\nRestartSec=10\nTimeoutStopSec=45\nNoNewPrivileges=true\nPrivateTmp=true\nProtectSystem=strict\nProtectHome=true\nProtectKernelTunables=true\nProtectKernelModules=true\nProtectControlGroups=true\nRestrictSUIDSGID=true\nReadWritePaths=/opt/gongwei/shared/data\nUMask=0007\nStandardOutput=journal\nStandardError=journal\n\n[Install]\nWantedBy=multi-user.target\n",
